{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ORANGE Player",
  "version": "1.0.0",
  "identifier": "com.orangeplayer.app",
  "build": {
    "frontendDist": "../../out",
    "beforeDevCommand": "cd ../.. && bun run dev",
    "beforeBuildCommand": "cd ../.. && bun run build:static",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "title": "ORANGE Player",
        "width": 1280,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "fullscreen": false,
        "resizable": true,
        "decorations": true,
        "backgroundColor": "#101419"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data: blob:; media-src 'self' https: http: blob:; connect-src 'self' https: http: ws: wss:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval' 'unsafe-inline'; font-src 'self' https: data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
