<!--
  ic_launcher_foreground.xml — ORANGE Player adaptive-icon foreground.
  An orange (#FF781F) hexagon with a graphite (#101419) center "play"
  aperture. Drawn inside the safe-zone (108x108 viewport, 72x72 visible).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer hexagon (orange brand) -->
    <path
        android:fillColor="#FF781F"
        android:pathData="M54,18 L84,36 L84,72 L54,90 L24,72 L24,36 Z" />

    <!-- Inner aperture (graphite) — gives the hexagon a "play hole" feel -->
    <path
        android:fillColor="#101419"
        android:pathData="M54,34 L70,43 L70,65 L54,74 L38,65 L38,43 Z" />

    <!-- Play triangle (white-ish, off-center for optical balance) -->
    <path
        android:fillColor="#F4F6F8"
        android:pathData="M50,44 L66,54 L50,64 Z" />
</vector>
